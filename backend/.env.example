# Copy to .env for local dev. On Render, set these in the service's
# Environment tab instead — never commit a real .env file.
#
# Vars marked (your spec) match exactly what you listed for Render.
# Vars marked (required addition) are things this backend needs that
# weren't in the original list — explained inline why.

# --- Your spec ---------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
ENVIRONMENT=production
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app

# --- Required additions --------------------------------------------------

# Django's own secret key (signs sessions/tokens) — NOT the same as any
# Supabase key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string

# Supabase Postgres connection string (this backend uses Supabase as its
# database via Django's ORM, not via Supabase's own client libraries).
# Project Settings -> Database -> Connection string -> URI.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# Your Render domain, so Django accepts requests for it.
DJANGO_ALLOWED_HOSTS=your-backend.onrender.com,localhost,127.0.0.1

# Explicit CORS/CSRF allow-lists. Defaults to FRONTEND_URL above if unset,
# but set explicitly if you ever add a second frontend origin (staging, etc).
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND.vercel.app
CSRF_TRUSTED_ORIGINS=https://YOUR-FRONTEND.vercel.app

# Supabase Storage S3-compatible credentials — generate these in the
# Supabase dashboard under Storage -> S3 Configuration. This is a
# SEPARATE credential pair from SUPABASE_SECRET_KEY above; it is what
# actually authenticates file uploads (article covers, gallery images,
# school forms, marksheets).
SUPABASE_S3_ACCESS_KEY_ID=replace-with-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
SUPABASE_S3_ENDPOINT=https://YOUR_PROJECT_ID.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-south-1
SUPABASE_S3_BUCKET=tvv-media

# Explicit debug flag. Leave unset/False in production — settings.py
# refuses to enable DEBUG at all when ENVIRONMENT=production, regardless
# of this value, as a hard safety net.
DJANGO_DEBUG=False
