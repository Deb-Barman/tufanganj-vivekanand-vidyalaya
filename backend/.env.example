# Copy this file to .env and fill in real values. Never commit .env itself.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-backend.onrender.com,localhost,127.0.0.1

# Database — Supabase PostgreSQL connection string
# Found in Supabase project settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# CORS / CSRF — the frontend origin(s) allowed to call this API
CORS_ALLOWED_ORIGINS=https://your-site.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-site.vercel.app,http://localhost:5173

# Supabase (backend-only usage, e.g. Storage). NEVER expose the service
# role key to the frontend — the frontend only ever gets SUPABASE_URL and
# the public anon key, configured separately in frontend/.env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

DJANGO_SECURE_SSL_REDIRECT=True
