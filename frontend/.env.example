# Copy to .env for local development, or set as environment variables in
# Vercel's project settings for deployment. Never commit a real .env file.

# Base URL of the Django backend API (no trailing slash after /api)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# If Supabase Storage/Auth is ever called directly from the frontend later,
# only the PUBLIC anon key belongs here — never the service role key.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=replace-with-anon-key
