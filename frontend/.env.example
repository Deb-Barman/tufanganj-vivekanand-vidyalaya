# Copy to .env for local dev, or set as environment variables in Vercel's
# project settings for deployment. Never commit a real .env file.

# Your Render backend's base URL — no trailing slash, no /api suffix
# (the app appends /api itself). Example: https://tvv-backend.onrender.com
VITE_API_URL=http://127.0.0.1:8000

# Not currently used by any code path (Django owns auth + the database;
# Supabase is only used server-side, as Postgres + Storage). Kept here in
# case a future feature reads Supabase Storage directly from the browser
# (e.g. signed URLs) — if you're not building that, you can leave these
# blank or omit them entirely.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
